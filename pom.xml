<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <name>jeesoul-ai-model</name>

    <groupId>com.jeesoul</groupId>
    <artifactId>jeesoul-ai-model</artifactId>
    <version>1.1.0-beta3</version>

    <description>jeesoul ai工具</description>

    <url>https://github.com/jeesoul/jeesoul-ai-model</url>
    <!-- 开发者信息 -->
    <developers>
        <developer>
            <name>dongxueyong</name>
            <email>3248838607@qq.com</email>
            <organization>com.jeesoul</organization>
        </developer>
    </developers>
    <!-- 开源许可证 -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <properties>
        <java.version>8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <spring-boot.version>2.7.17</spring-boot.version>
        <!-- HttpClient5 版本：对齐 Spring Boot 2.7.x BOM，作为本库编译与支持的最低版本。
             抽成属性便于用 -Djeesoul.httpclient5.version=x.y.z 做跨版本兼容性验证。
             属性名带 jeesoul 前缀，避免与 Spring Boot BOM 的同名属性混淆。 -->
        <jeesoul.httpclient5.version>5.1.4</jeesoul.httpclient5.version>
        <jeesoul.httpcore5.version>5.1.5</jeesoul.httpcore5.version>
    </properties>

    <repositories>

    </repositories>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-parent</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- HttpClient5 依赖：版本对齐 Spring Boot 2.7.x BOM（httpclient5 5.1.4 / httpcore5 5.1.5）。
             使用方若继承 spring-boot-starter-parent，其 dependencyManagement 优先级高于传递依赖，
             会把这里的版本强制改写为 BOM 管理的版本。因此本库按 5.1.x 这个最低版本编译，
             确保代码不会用到 5.2+ 才有的 API（如 ConnectionConfig），避免使用方运行时 NoClassDefFoundError。
             使用方需要更高版本时可自行在其 pom 直接声明覆盖，本库代码在 5.1.x~5.5.x 全区间可运行。 -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>${jeesoul.httpclient5.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5</artifactId>
            <version>${jeesoul.httpcore5.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5-h2</artifactId>
            <version>${jeesoul.httpcore5.version}</version>
        </dependency>
        <!-- 日志支持 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
        </dependency>
        <!-- 工具类支持 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
        <!--集成响应式编程-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <!-- 版本控制仓库地址 -->
    <scm>
        <connection>scm:git:git@github.com:jeesoul/jeesoul-ai-model.git</connection>
        <developerConnection>scm:git:git@github.com:jeesoul/jeesoul-ai-model.git</developerConnection>
        <url>https://github.com/jeesoul/jeesoul-ai-model</url>
    </scm>
    <build>
        <plugins>
            <!-- 编译插件：显式锁定 Java 8，避免默认 source 1.5 导致 lambda 等语法编译失败 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <!-- central发布插件 -->
            <!-- 版本须保持较新：0.4.0 的响应模型不认服务端新增的 warnings 字段，
                 会在上传成功后的状态轮询阶段抛 UnrecognizedPropertyException 导致构建失败 -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.11.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>mymaven</publishingServerId>
                </configuration>
            </plugin>
            <!-- source源码插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>2.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- javadoc插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>2.9.1</version>
                <configuration>
                    <tags>
                        <tag>
                            <name>date</name>
                            <placement>a</placement>
                            <head>Date:</head>
                        </tag>
                    </tags>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>1.5</version>
                <configuration>
                    <executable>D:\app\GnuPG\bin\gpg.exe</executable>
                    <keyname>com.jeesoul</keyname>
                </configuration>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
